# Copy to .env.local for local development, or set these in your hosting provider (Vercel, Netlify, ...).
# Leave everything empty to run Learnly as a browser-only demo.

# Supabase project (Project Settings -> API). The anon key is public by design; row level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "stripe" turns on real Premium payments (needs the Stripe secrets on the Supabase functions).
VITE_PAYMENTS=

# "http" uses the real AI through the Supabase "ai" function (needs ANTHROPIC_API_KEY on the functions).
VITE_AI_PROVIDER=

# Never put STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET or ANTHROPIC_API_KEY here: anything starting with VITE_ ends up in the browser.
# Those go into Supabase with `npx supabase secrets set` (see docs/EINRICHTUNG.md).
